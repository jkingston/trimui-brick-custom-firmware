From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brick Linux <brick-linux@localhost>
Date: Thu, 5 Nov 2026 00:00:00 +0000
Subject: [PATCH] plain_drm: bound page-flip failure

The Allwinner display engine accepts the backend's original blocking atomic
FB_ID update. Propagate an unexpected failure to the video driver instead of
continuing an unbounded render loop on a black screen.
---
 gfx/drivers/drm_gfx.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -270,7 +270,7 @@
    surface->flip_page = 0;
 }
 
-static void drm_page_flip(struct drm_surface *surface)
+static bool drm_page_flip(struct drm_surface *surface)
 {
    /* We already have the id of the FB_ID property of
     * the plane on which we are going to do a pageflip:
@@ -288,6 +288,8 @@
          surface->pages[surface->flip_page].buf.fb_id) < 0)
    {
       RARCH_ERR("[DRM] Failed to add atomic property for pageflip.\n");
+      drmModeAtomicFree(req);
+      return false;
    }
    /*... now we just need to do the commit */
 
@@ -299,11 +301,14 @@
    if (drmModeAtomicCommit(drm.fd, req, 0, NULL) < 0)
    {
       RARCH_ERR("[DRM] Failed to commit for pageflip.\n");
+      drmModeAtomicFree(req);
+      return false;
    }
 
    surface->flip_page = !(surface->flip_page);
 
    drmModeAtomicFree(req);
+   return true;
 }
 
 static void drm_surface_update(void *data, const void *frame,
@@ -787,7 +792,7 @@
    drm_surface_update(_drmvars, frame, _drmvars->main_surface);
    /* The menu owns the single plane until it closes. */
    if (!_drmvars->menu_active)
-      drm_page_flip(_drmvars->main_surface);
+      return drm_page_flip(_drmvars->main_surface);
    return true;
 }
 
