From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brick Linux <brick-linux@localhost>
Date: Sun, 1 Nov 2026 00:00:00 +0000
Subject: [PATCH] plain_drm: synchronise page flips

The plain DRM backend submits framebuffer changes without asking for a
completion event. On drivers where the atomic ioctl returns before the new
buffer is scanned out, the following frame can overwrite a buffer that is
still visible, causing tearing and uneven frame pacing.

Request a page-flip event and wait for it before recycling the next buffer.
This is the same ownership rule used by the current upstream DRM backend.
---
 gfx/drivers/drm_gfx.c | 38 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 37 insertions(+), 1 deletion(-)

diff --git a/gfx/drivers/drm_gfx.c b/gfx/drivers/drm_gfx.c
index 1111111111..2222222222 100644
--- a/gfx/drivers/drm_gfx.c
+++ b/gfx/drivers/drm_gfx.c
@@ -21,6 +21,7 @@
 #include <xf86drmMode.h>
 #include <libdrm/drm_fourcc.h>
 #include <fcntl.h>
+#include <poll.h>
 #include <sys/mman.h>

 #include <compat/strl.h>
@@ -270,6 +271,18 @@ static void drm_surface_setup(void *data,  int src_width, int src_height,
    surface->flip_page = 0;
 }

+static void drm_page_flip_handler(int fd, unsigned frame, unsigned sec,
+      unsigned usec, void *data)
+{
+   bool *waiting_for_flip = (bool*)data;
+
+   (void)fd;
+   (void)frame;
+   (void)sec;
+   (void)usec;
+   *waiting_for_flip = false;
+}
+
 static void drm_page_flip(struct drm_surface *surface)
 {
    /* We already have the id of the FB_ID property of
@@ -296,10 +309,35 @@ static void drm_page_flip(struct drm_surface *surface)
     * pageflip is complete. If you don't want -12 errors
     * (ENOMEM), namely "Cannot allocate memory", then
     * you must drain the event queue of that fd. */
-   if (drmModeAtomicCommit(drm.fd, req, 0, NULL) < 0)
+   bool waiting_for_flip     = true;
+   drmEventContext evctx     = {0};
+   struct pollfd pfd         = {0};
+
+   evctx.version             = 2;
+   evctx.page_flip_handler   = drm_page_flip_handler;
+   pfd.fd                    = drm.fd;
+   pfd.events                = POLLIN;
+
+   if (drmModeAtomicCommit(drm.fd, req,
+         DRM_MODE_ATOMIC_NONBLOCK | DRM_MODE_PAGE_FLIP_EVENT,
+         &waiting_for_flip) < 0)
    {
       RARCH_ERR("[DRM] Failed to commit for pageflip.\n");
    }
+   else
+   {
+      while (waiting_for_flip)
+      {
+         int ret = poll(&pfd, 1, 1000);
+         if (ret > 0 && (pfd.revents & POLLIN))
+            drmHandleEvent(drm.fd, &evctx);
+         else
+         {
+            RARCH_ERR("[DRM] Timed out waiting for pageflip.\n");
+            break;
+         }
+      }
+   }

    surface->flip_page = !(surface->flip_page);

--
2.51.0
