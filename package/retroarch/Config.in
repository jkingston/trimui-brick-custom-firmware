config BR2_PACKAGE_RETROARCH
	bool "RetroArch"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBUDEV_ZERO
	help
	  Minimal RetroArch frontend using plain DRM, ALSA and evdev/udev.

comment "RetroArch needs an MMU, threads and a dynamic library toolchain"
	depends on !BR2_USE_MMU || !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
